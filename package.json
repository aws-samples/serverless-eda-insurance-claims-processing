{
  "name": "insurance",
  "version": "0.1.0",
  "bin": {
    "insurance": "bin/insurance.js"
  },
  "scripts": {
    "build": "npm install && tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:claims": "cdk deploy ClaimsProcessingStack --outputs-file react-claims/src/cdk-outputs.json --require-approval never",
    "deploy:voice": "cdk deploy VoiceFnolStack --outputs-file react-claims/src/cdk-outputs.json --require-approval never",
    "deploy:all": "npm run deploy:claims && npm run deploy:voice",
    "deploy": "npm run deploy:all",
    "frontend:install": "cd react-claims && npm ci",
    "frontend:build": "cd react-claims && npm run build",
    "deploy:frontend": "npm run frontend:build && npm run deploy:claims",
    "destroy:claims": "cdk destroy ClaimsProcessingStack",
    "destroy:voice": "cdk destroy VoiceFnolStack",
    "destroy:all": "npm run destroy:voice && npm run destroy:claims",
    "destroy": "npm run destroy:all",
    "format": "npx prettier --write ."
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1131.0",
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-eventbridge": "^3.1131.0",
    "@aws-sdk/client-iot": "^3.1131.0",
    "@aws-sdk/client-iot-data-plane": "^3.1131.0",
    "@aws-sdk/client-rekognition": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-textract": "^3.1131.0",
    "@aws-sdk/credential-provider-node": "^3.972.83",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "email-validator": "^2.0.4",
    "install": "^0.13.0",
    "jest": "^29.7.0",
    "npm": "^10.9.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "uuid": "^11.0.5"
  },
  "dependencies": {
    "@aws-cdk/lambda-layer-kubectl-v36": "^2.0.1",
    "@aws-lambda-powertools/metrics": "^2.35.0",
    "@aws-solutions-constructs/aws-eventbridge-sqs": "^2.104.0",
    "aws-cdk-lib": "^2.269.0",
    "aws-jwt-verify": "^5.2.1",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21",
    "uninstall": "0.0.0"
  }
}
